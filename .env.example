# NaviKarier — Root Environment Variables
# Copy to .env and fill in real values. Never commit .env.

# ============ Backend ============

# Database
DATABASE_URL=sqlite:///./navikarier.db
# DATABASE_URL=postgresql://user:password@host:5432/navikarier

# CORS — comma-separated origins
CORS_ORIGINS=http://localhost:3000

# AI-powered CV analysis (optional — kosongkan untuk fallback mode)
ANTHROPIC_API_KEY=

# App
APP_ENV=development

# Email (Resend — opsional, tanpa key = log ke console)
RESEND_API_KEY=
FROM_EMAIL=NaviKarier <noreply@navikarier.com>
FRONTEND_URL=http://localhost:3000

# ============ Frontend ============

# Backend API URL
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# NextAuth secret (wajib)
AUTH_SECRET=your-secret-key-here

# NextAuth URL
NEXTAUTH_URL=http://localhost:3000

# Google OAuth (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
