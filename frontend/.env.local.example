# Copy ke .env.local (lokal) atau set sebagai Environment Variables di Vercel (produksi).
# Variable berawalan NEXT_PUBLIC_ akan ter-expose ke browser.

# URL backend FastAPI.
#   Lokal   : http://127.0.0.1:8000  (pakai 127.0.0.1, bukan localhost, agar fetch server-side jalan di Windows)
#   Vercel  : URL backend produksi, mis. https://navikarier-api.onrender.com
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000

# NextAuth v5 — wajib. Isi dengan random string (mis. `openssl rand -base64 32`).
AUTH_SECRET=ganti-dengan-random-string

# Produksi (Vercel): URL penuh app, mis. https://navikarier.vercel.app
# Lokal boleh dikosongkan.
AUTH_URL=

# Google OAuth. Opsional lokal; wajib kalau mau login Google.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Secret bridge OAuth Google -> backend. HARUS sama persis dengan OAUTH_BRIDGE_SECRET di backend.
OAUTH_BRIDGE_SECRET=navikarier-oauth-bridge-dev
