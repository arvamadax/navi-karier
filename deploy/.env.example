# Salin ke deploy/.env di home-server (chmod 600). Jangan di-commit.
# Salin nilai secret LAMA dari dashboard Render/Vercel supaya sesi login & akun tetap valid.

FRONTEND_URL=https://navikarier.mkxapp.tech
API_URL=https://api-navikarier.mkxapp.tech

POSTGRES_PASSWORD=             # baru, acak: openssl rand -hex 24

JWT_SECRET=                    # sama dengan Render (kalau beda, semua user logout)
OAUTH_BRIDGE_SECRET=           # sama dengan Render DAN Vercel
AUTH_SECRET=                   # sama dengan Vercel

ANTHROPIC_API_KEY=             # kosong = analisis fallback rule-based
RESEND_API_KEY=                # kosong = email hanya di-log
FROM_EMAIL=NaviKarier <noreply@navikarier.com>
CONTACT_EMAIL=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
